
# ============================================================
# Project Configuration
# ============================================================
# The prefix used for container names (e.g., dev, prod)
COMPOSE_PROJECT_NAME=name
CONTAINER_PREFIX=name

# ============================================================
# Service Ports (External Host Ports)
# ============================================================
# Format: PORT_NAME=HOST_PORT
PORT_STREAMLIT=9501
PORT_POSTGRES=9432
PORT_PGADMIN=9050
PORT_ARANGO=9529
PORT_OLLAMA=11435
PORT_QDRANT=9333
PORT_MINIO_API=9600
PORT_MINIO_CONSOLE=9601
PORT_TRANSFORMERS=9080
PORT_RETRIEVAL=9100
PORT_FRONTEND=9001

# ============================================================
# Application Settings
# ============================================================
# Model choice for the extraction (e.g., Chandra, LightOn)
MODEL_CHOICE=Chandra
OLLAMA_MODEL=llama3.1:8b

# ============================================================
# Credentials (Change these for production!)
# ============================================================
POSTGRES_USER=extract_user
POSTGRES_PASSWORD=extract_pass
POSTGRES_DB=extraction_db

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# External API Keys
NVIDIA_API_KEY=