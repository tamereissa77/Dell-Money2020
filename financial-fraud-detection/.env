# Host ports. 8080 is taken on this box by openshell-gateway - the demo uses 8090.
DEMO_PORT=8090
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002

# How many top-confidence frauds get their Shapley explanation pre-computed at
# startup so booth-scripted transactions appear instantly.
HERO_N=12

# v2 pipeline. FEED_SOURCE=file keeps the original v1 booth demo byte-for-byte;
# set kafka to drive the UI from the streaming pipeline.
FEED_SOURCE=file
BROKER_PORT=19092
GEN_PORT=8091
SCORE_PORT=8092

# screening-stub calibration. The velocity rule dominates at demo TPS because
# the generator samples users uniformly, so per-card rate is artificial rather
# than behavioural. Tuned for a realistic ~5% alert rate while keeping the
# false-positive rate in the 90-98% band real engines actually live in.
RULE_AMOUNT=500
RULE_VELOCITY_COUNT=12
