# Copy this file to .env and fill in your values
# Never commit .env to git

# NVIDIA NIM API (for cloud VLM fallback in extractor_service)
VISION_API_KEY=nvapi-your-key-here
NVIDIA_API_KEY=nvapi-your-key-here

# HuggingFace (for downloading base model on first run)
HF_TOKEN=hf_your-token-here

# Google Sheets integration (optional — leave blank to disable)
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=service_account.json
GOOGLE_API_KEY=

HF_CACHE=./hf-cache
