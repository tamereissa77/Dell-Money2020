# Model server — mirrors the validated DGX Spark (GB10) deployment.
VLLM_IMAGE=vllm/vllm-openai:v0.18.0-cu130
MODEL_HOST_DIR=/opt/models/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
MODEL_CONTAINER_DIR=/models/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
SERVED_MODEL_NAME=nemotron-nano
HF_CACHE_DIR=/opt/huggingface-cache
VLLM_PORT=8000
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=2
VLLM_MAX_NUM_BATCHED_TOKENS=16384
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_KV_CACHE_DTYPE=fp8
VLLM_SHM_SIZE=16g
VLLM_USE_FLASHINFER_MOE_FP8=1
VLLM_FLASHINFER_MOE_BACKEND=throughput
VLLM_REASONING_PARSER_PLUGIN=/models/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8/nano_v3_reasoning_parser.py
VLLM_REASONING_PARSER=nano_v3
TORCH_CUDA_ARCH_LIST=12.1a

# Trace viewer — the booth screen.
PHOENIX_IMAGE=arizephoenix/phoenix:14.15.0
PHOENIX_PORT=6006
